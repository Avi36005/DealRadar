# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables & deployment secrets
.env
.env.local
.env.*.local
secrets.env

# Next.js build output
.next/
frontend/.next/
out/

# Production builds
dist/
build/

# Orchids
.orchids/

# macOS
.DS_Store
__MACOSX/

# Archives
*.zip

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Misc
*.tgz
*.tar.gz

# Python
__pycache__/
**/__pycache__/
*.pyc
backend/venv/
backend/.venv/

# Backend runtime storage (regenerated on startup / first run)
backend/storage/uploads/*
backend/storage/page_images/*
backend/storage/parsed/*
backend/storage/vector_db/*
backend/storage/documents.json
!backend/storage/**/.gitkeep
