# --- LLM (free tier) -----------------------------------------------------------------
# Primary: Groq (free, fast Llama 3.3) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary: Google Gemini (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional, used only if both Groq and Gemini are unavailable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local fallback if no cloud LLM key is set (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Voice (optional) ------------------------------------------------------------------
# Enables "AI Voice Replies" (text-to-speech) in the chat UI — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Security --------------------------------------------------------------------------
# Required header (X-API-Key) for every endpoint. Generate with:
#   python -c "import secrets; print(secrets.token_hex(16))"
API_SECRET_KEY=your_random_32char_secret

# Comma-separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://documentiq-app.web.app,https://documentiq-app.firebaseapp.com

# --- Storage -----------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=50
CHROMA_PERSIST_DIR=./storage/vector_db
UPLOAD_DIR=./storage/uploads
PAGE_IMAGES_DIR=./storage/page_images
